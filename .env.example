# ─────────────────────────────────────────────────────────────
#  Stockmachine — AI 투자 비서 환경변수 예시
#  실제 값을 채운 뒤 파일명을 .env 로 저장하세요. (.env 는 git 에 커밋되지 않음)
# ─────────────────────────────────────────────────────────────

# ── Anthropic (Claude) — 증시 분석/추천 생성에 사용 ────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 선택: 모델 오버라이드 (기본값 claude-opus-4-8)
# ADVISOR_MODEL=claude-opus-4-8

# ── 이메일 (SMTP) — HTML 리포트 발송 ─────────────────────────
# Gmail 사용 시: 2단계 인증 후 "앱 비밀번호" 를 발급받아 사용하세요.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password
# 수신자 (여러 명은 콤마로 구분). 미설정 시 기본값: hj.jin@kt.com, jhj980912@naver.com
MAIL_TO=hj.jin@kt.com,jhj980912@naver.com
# 선택: 발신자 표시 이름
MAIL_FROM_NAME=AI 투자비서

# ── 이메일 회신 읽기 (IMAP) — 보유종목 자동 업데이트 ─────────
# 브리핑 메일에 회신하면 그 내용을 읽어 보유/관심종목을 갱신합니다.
# 미설정 시 SMTP 계정/호스트에서 자동 추론합니다(gmail/naver/daum 등).
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=your_gmail@gmail.com
# IMAP_PASSWORD=your_gmail_app_password
# IMAP_MAILBOX=INBOX
# 선택: 회신을 반영할 신뢰 발신자(미설정 시 MAIL_TO 수신자와 동일)
# HOLDINGS_UPDATE_SENDERS=hj.jin@kt.com,jhj980912@naver.com

# ── 카카오톡 — "나에게 보내기" 요약 발송 ─────────────────────
# https://developers.kakao.com 에서 앱 생성 → REST API 키 및
# 카카오 로그인(talk_message 동의) 후 리프레시 토큰을 발급받아 넣으세요.
KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_REFRESH_TOKEN=your_kakao_refresh_token
# 앱 보안 설정에서 Client Secret 사용(활성)한 경우에만 필요
KAKAO_CLIENT_SECRET=your_kakao_client_secret
# 선택: 카톡 메시지에 넣을 "자세히 보기" 링크 (호스팅된 리포트 URL 등)
KAKAO_LINK_URL=
